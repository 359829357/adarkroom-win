{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A Dark Room",
  "version": "1.4.0",
  "identifier": "games.doublespeakgames.adarkroom",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "A Dark Room",
        "width": 1000,
        "height": 760,
        "minWidth": 480,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
