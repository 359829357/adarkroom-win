{
  "name": "adarkroom-desktop",
  "version": "1.4.0",
  "private": true,
  "description": "Desktop wrapper for A Dark Room (minimalist text adventure)",
  "author": "wrapper build",
  "license": "MPL-2.0",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node dev-server.mjs",
    "dist:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "games.doublespeakgames.adarkroom",
    "productName": "A Dark Room",
    "artifactName": "ADarkRoom-portable-${version}.${ext}",
    "compression": "maximum",
    "files": [
      "desktop/**/*",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "requestExecutionLevel": "user",
      "unpackDirName": "ADarkRoom"
    }
  }
}
